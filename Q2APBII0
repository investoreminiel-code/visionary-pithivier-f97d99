function addToCart(id){
  const p = PRODUCTS.find(x=>x.id===id);
  const line = cart.find(c=>c.id===id);
  if(line) line.qty++; else cart.push({id:p.id, name:p.name, price:p.price, qty:1});
  renderCart();
  openCart();
}
async function orderNow(id){
  const p = PRODUCTS.find(x=>x.id===id);
  const line = cart.find(c=>c.id===id);
  if(line) line.qty++; else cart.push({id:p.id, name:p.name, price:p.price, qty:1});
  renderCart();
  await checkout();
}
function changeQty(id, delta){
  const line = cart.find(c=>c.id===id);
  if(!line) return;
  line.qty += delta;
  if(line.qty<=0) cart = cart.filter(c=>c.id!==id);
  renderCart();
}
function renderCart(){
  const body = document.getElementById('cartBody');
  const count = cart.reduce((a,c)=>a+c.qty,0);
  const countEl = document.getElementById('cartCount');
  countEl.style.display = count? 'block':'none';
  countEl.textContent = count;
  if(cart.length===0){
    body.innerHTML = `<div class="empty-state">Your cart is empty.<div><button class="btn small" onclick="closeCart(); go('store');">Browse merch</button></div></div>`;
  } else {
    body.innerHTML = cart.map(c=>{
      const prod = PRODUCTS.find(p=>p.id===c.id);
      const thumbImg = prod && prod.img ? `<img src="${prod.img}" style="width:100%;height:100%;object-fit:cover;">` : '';
      return `
      <div class="cart-line">
        <div class="thumb">${thumbImg}</div>
        <div class="info">
          <div class="name">${c.name}</div>
          <div class="meta">$${c.price} each</div>
        </div>
        <div class="qty-ctrl">
          <button onclick="changeQty('${c.id}',-1)">−</button>
          <span class="mono">${c.qty}</span>
          <button onclick="changeQty('${c.id}',1)">+</button>
        </div>
      </div>`;
    }).join('');
  }
  const total = cart.reduce((a,c)=>a+c.price*c.qty,0);
  document.getElementById('cartTotal').textContent = '$'+total.toFixed(2);
}
function openCart(){ document.getElementById('overlay').classList.add('open'); document.getElementById('cartDrawer').classList.add('open'); }
function closeCart(){ document.getElementById('overlay').classList.remove('open'); document.getElementById('cartDrawer').classList.remove('open'); }

async function checkout(){
  if(cart.length===0) return;
  const membership = await storeGet('membership', null);
  let total = cart.reduce((a,c)=>a+c.price*c.qty,0);
  let discount = 0;
  if(membership){
    discount = membership.tier==='platinum' ? 0.25 : membership.tier==='gold' ? 0.15 : 0.10;
  }
  const finalTotal = total * (1-discount);
  const order = {
    orderId: 'ORD-'+Math.random().toString(36).slice(2,8).toUpperCase(),
    date: new Date().toISOString(),
    items: cart.map(c=>({name:c.name, qty:c.qty, price:c.price})),
    subtotal: total,
    discount,
    total: finalTotal,
    status: 'processing',
    shipment: 'preparing'
  };
  const orders = await storeGet('orders', []);
  orders.unshift(order);
  await storeSet('orders', orders);
  cart = [];
  renderCart();
  closeCart();
  alert('Order confirmed: '+order.orderId+' — total $'+finalTotal.toFixed(2)+(discount? ' (member discount applied)':'')+'. This is a simulated payment, no real charge occurred.');
  go('dashboard');
  renderDashboard();
}

