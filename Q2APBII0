<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Slaughter to Prevail — Official Fan Hub</title>
<link rel="icon" type="image/png" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Barlow:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --void:#0b0a0c;
  --void-2:#151317;
  --panel:#1c1a1f;
  --blood:#c81e2c;
  --blood-dim:#7a1219;
  --rust:#8c3a1d;
  --bone:#ece6da;
  --bone-dim:#a29c8f;
  --steel:#38353c;
  --toxic:#c9a227;
  --line:#2c292f;
}
*{box-sizing:border-box; margin:0; padding:0;}
html{scroll-behavior:smooth; overflow-x:hidden;}
body{
  background:var(--void);
  color:var(--bone);
  font-family:'Barlow',sans-serif;
  line-height:1.5;
  min-height:100vh;
  overflow-x:hidden;
  width:100%;
}
img{max-width:100%;}
h1,h2,h3,h4{
  font-family:'Oswald',sans-serif;
  text-transform:uppercase;
  letter-spacing:0.03em;
  color:var(--bone);
  font-weight:600;
}
a{color:inherit;}
button{font-family:inherit;}
.wrap{max-width:1180px; margin:0 auto; padding:0 24px;}
.mono{font-family:'JetBrains Mono',monospace;}
.eyebrow{
  font-family:'JetBrains Mono',monospace;
  font-size:12px;
  letter-spacing:0.18em;
  text-transform:uppercase;
  color:var(--blood);
  display:flex;
  align-items:center;
  gap:8px;
}
.eyebrow::before{content:''; width:18px; height:2px; background:var(--blood); display:inline-block;}

/* ---------- NAV ---------- */
header{
  position:sticky; top:0; z-index:100;
  background:rgba(11,10,12,0.95);
  border-bottom:1px solid var(--line);
  backdrop-filter:blur(4px);
}
.navbar{
  display:flex; align-items:center; justify-content:space-between;
  padding:8px 24px; max-width:1180px; margin:0 auto;
  flex-wrap:wrap; row-gap:10px;
}
.brand{
  font-family:'Oswald',sans-serif;
  font-weight:700;
  font-size:20px;
  letter-spacing:0.02em;
  display:flex; align-items:center; gap:10px;
  cursor:pointer;
}
.nav-logo-img{
  display:block;
  width:auto;
  height:68px;
  max-width:240px;
  object-fit:contain;
}
nav.links{display:flex; gap:2px; flex-wrap:wrap;}
nav.links button{
  background:none; border:none; color:var(--bone-dim);
  font-family:'Oswald',sans-serif; font-weight:600; font-size:14px;
  letter-spacing:0.04em; text-transform:uppercase;
  padding:10px 12px; cursor:pointer; border-bottom:2px solid transparent;
  transition:color .15s;
}
nav.links button:hover{color:var(--bone);}
nav.links button.active{color:var(--blood); border-bottom-color:var(--blood);}
.nav-actions{display:flex; gap:10px; align-items:center;}
.icon-btn{
  background:none; border:1px solid var(--line); color:var(--bone);
  width:36px; height:36px; cursor:pointer; position:relative;
  display:flex; align-items:center; justify-content:center;
}
.icon-btn:hover{border-color:var(--blood);}
.badge-count{
  position:absolute; top:-6px; right:-6px; background:var(--blood); color:var(--bone);
  font-size:10px; font-family:'JetBrains Mono',monospace; padding:1px 5px;
}
.burger{display:none;}

/* ---------- BUTTONS ---------- */
.btn{
  display:inline-flex; align-items:center; justify-content:center; gap:8px;
  padding:12px 22px; background:var(--blood); color:var(--void);
  font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.08em;
  text-transform:uppercase; font-weight:700; border:none; cursor:pointer;
  clip-path:polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px);
  transition:transform .1s, background .15s;
}
.btn:hover{background:#e02a3a;}
.btn:active{transform:scale(0.98);}
.btn.ghost{
  background:none; color:var(--bone); border:1px solid var(--line);
  clip-path:none;
}
.btn.ghost:hover{border-color:var(--blood); color:var(--blood);}
.btn.small{padding:8px 14px; font-size:11px;}
.btn.block{width:100%;}
.btn:disabled{opacity:0.4; cursor:not-allowed;}

/* ---------- VIEWS ---------- */
.view{display:none; animation:fade .25s ease;}
.view.active{display:block;}
@keyframes fade{from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:translateY(0);}}

/* ---------- HERO ---------- */
.hero{
  position:relative; padding:90px 24px 70px; overflow:hidden;
  background:
    linear-gradient(180deg, rgba(11,10,12,0.88) 0%, rgba(21,19,23,0.94) 100%),
    url('data:image/jpeg;base64,') center 30% / cover no-repeat;
  border-bottom:1px solid var(--line);
}
.hero::before{
  content:''; position:absolute; inset:0;
  background-image:
    repeating-linear-gradient(115deg, transparent 0 60px, rgba(200,30,44,0.06) 60px 62px);
  pointer-events:none;
}
.hero-inner{max-width:1180px; margin:0 auto; position:relative;}
.hero h1{
  font-size:clamp(42px, 8vw, 92px);
  line-height:0.95;
  margin:14px 0 18px;
  color:var(--bone);
  text-shadow:0 2px 18px rgba(0,0,0,0.6);
}
.hero h1 span{color:var(--blood);}
.hero p.lede{max-width:520px; color:var(--bone-dim); font-size:17px; margin-bottom:28px;}
.hero-actions{display:flex; gap:14px; flex-wrap:wrap; margin-bottom:46px;}
.countdown-block{
  display:inline-flex; gap:1px; background:var(--line); border:1px solid var(--line);
  max-width:100%; flex-wrap:wrap;
}
.countdown-block .seg{
  background:var(--panel); padding:14px 18px; min-width:64px; text-align:center; flex:1 1 auto;
}
@media(max-width:420px){
  .countdown-block .seg{padding:10px 8px; min-width:56px;}
  .countdown-block .seg .num{font-size:22px;}
}
.countdown-block .seg .num{font-family:'JetBrains Mono',monospace; font-size:28px; font-weight:700; color:var(--blood);}
.countdown-block .seg .lbl{font-size:10px; letter-spacing:0.12em; text-transform:uppercase; color:var(--bone-dim); margin-top:4px;}
.countdown-label{font-size:12px; color:var(--bone-dim); margin-bottom:10px; letter-spacing:0.04em;}

/* ---------- SECTIONS ---------- */
section{padding:64px 0;}
section.alt{background:var(--void-2); border-top:1px solid var(--line); border-bottom:1px solid var(--line);}
.section-head{display:flex; align-items:flex-end; justify-content:space-between; margin-bottom:32px; flex-wrap:wrap; gap:12px;}
.section-head h2{font-size:clamp(26px,4vw,38px);}

.grid{display:grid; gap:20px;}
.grid.cols-4{grid-template-columns:repeat(4,1fr);}
.grid.cols-3{grid-template-columns:repeat(3,1fr);}
.grid.cols-2{grid-template-columns:repeat(2,1fr);}
@media(max-width:920px){.grid.cols-4{grid-template-columns:repeat(2,1fr);} .grid.cols-3{grid-template-columns:repeat(2,1fr);}}
@media(max-width:600px){.grid.cols-4,.grid.cols-3,.grid.cols-2{grid-template-columns:1fr;}}
@media(max-width:640px){.tour-row{grid-template-columns:1fr !important; row-gap:8px;}}
@media(max-width:420px){.tier-tiles{grid-template-columns:1fr !important;}}

/* ---------- CARDS ---------- */
.card{
  background:var(--panel); border:1px solid var(--line); padding:20px;
  position:relative;
}
.card .tag{
  position:absolute; top:0; right:0; background:var(--blood); color:var(--void);
  font-family:'JetBrains Mono',monospace; font-size:10px; padding:4px 8px; letter-spacing:0.05em;
}
.card .tag.limited{background:var(--toxic);}
.media-block{
  aspect-ratio:4/5; background:
    linear-gradient(145deg, var(--steel), var(--void-2));
  display:flex; align-items:center; justify-content:center;
  margin-bottom:16px; position:relative; overflow:hidden;
}
.media-block::after{
  content:''; position:absolute; inset:0;
  background:repeating-linear-gradient(45deg, transparent 0 8px, rgba(255,255,255,0.02) 8px 16px);
}
.media-block .glyph{font-family:'Oswald',sans-serif; font-size:13px; color:var(--bone-dim); letter-spacing:0.08em; text-transform:uppercase; z-index:1;}
.media-block.square{aspect-ratio:1/1;}
.media-block.wide{aspect-ratio:16/9;}

.product-name{font-family:'Oswald',sans-serif; font-size:17px; text-transform:none; margin-bottom:4px;}
.product-cat{font-size:12px; color:var(--bone-dim); font-family:'JetBrains Mono',monospace; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:10px;}
.price-row{display:flex; align-items:center; justify-content:space-between; margin-top:14px;}
.price{font-family:'JetBrains Mono',monospace; font-size:18px; font-weight:700; color:var(--bone);}
.price .member-off{font-size:11px; color:var(--toxic); display:block; font-weight:400; margin-top:2px;}

/* ---------- TICKET STUB (signature element) ---------- */
.ticket-stub{
  display:flex; background:var(--panel); border:1px solid var(--line);
  position:relative; overflow:visible; max-width:100%; flex-wrap:wrap;
}
.ticket-stub .main{flex:1 1 240px; padding:22px 24px; min-width:0;}
.ticket-stub .stub{
  width:120px; padding:22px 14px; border-left:2px dashed var(--steel);
  display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px;
  background:var(--void-2);
}
@media(max-width:480px){
  .ticket-stub .stub{width:100%; border-left:none; border-top:2px dashed var(--steel); flex-direction:row; justify-content:space-between; padding:14px 18px;}
  .ticket-stub .stub::before,.ticket-stub .stub::after{display:none;}
}
.ticket-stub .stub::before,.ticket-stub .stub::after{
  content:''; position:absolute; width:20px; height:20px; background:var(--void);
  border-radius:50%; right:104px;
}
.ticket-stub .stub::before{top:-10px;}
.ticket-stub .stub::after{bottom:-10px;}
.barcode{display:flex; gap:2px; height:38px; align-items:stretch;}
.barcode span{display:inline-block; width:3px; background:var(--bone);}
.ticket-code{font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--bone-dim); letter-spacing:0.05em;}

/* ---------- FORMS ---------- */
label{display:block; font-size:12px; text-transform:uppercase; letter-spacing:0.06em; color:var(--bone-dim); margin-bottom:6px; font-family:'JetBrains Mono',monospace;}
input,select,textarea{
  width:100%; background:var(--void-2); border:1px solid var(--line); color:var(--bone);
  padding:11px 12px; font-family:'Barlow',sans-serif; font-size:14px; margin-bottom:16px;
}
input:focus,select:focus,textarea:focus{outline:none; border-color:var(--blood);}
textarea{min-height:110px; resize:vertical;}
.field-row{display:grid; grid-template-columns:1fr 1fr; gap:16px;}
@media(max-width:600px){.field-row{grid-template-columns:1fr;}}
.radio-tiles{display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:16px;}
.radio-tile{
  border:1px solid var(--line); padding:14px; cursor:pointer; background:var(--void-2);
}
.radio-tile.selected{border-color:var(--blood); background:rgba(200,30,44,0.08);}
.radio-tile .t-name{font-family:'Oswald',sans-serif; font-size:14px;}
.radio-tile .t-price{font-family:'JetBrains Mono',monospace; color:var(--blood); font-size:13px; margin-top:4px;}

/* ---------- MISC ---------- */
.divider{height:1px; background:var(--line); margin:40px 0;}
.footer{border-top:1px solid var(--line); padding:40px 0 60px; color:var(--bone-dim); font-size:13px;}
.footer-logo-wrap{text-align:center; margin-bottom:18px; line-height:0; overflow:hidden;}
.footer-logo-img{
  display:block;
  width:auto;
  height:118px;
  max-width:min(88vw, 360px);
  margin:0 auto;
  object-fit:contain;
}
.footer .cols{display:flex; justify-content:space-between; flex-wrap:wrap; gap:24px; margin-bottom:24px;}
.footer a{color:var(--bone-dim); text-decoration:none;}
.footer a:hover{color:var(--blood);}
.pill{display:inline-block; font-family:'JetBrains Mono',monospace; font-size:10px; padding:4px 10px; border:1px solid var(--line); color:var(--bone-dim); letter-spacing:0.05em; text-transform:uppercase;}
.pill.demo{border-color:var(--toxic); color:var(--toxic);}
.notice{border:1px solid var(--toxic); background:rgba(201,162,39,0.06); padding:12px 16px; font-size:13px; color:var(--toxic); margin-bottom:24px;}
.notice.blood{border-color:var(--blood); background:rgba(200,30,44,0.06); color:#ff8f97;}

/* accordion */
.accordion-item{border-bottom:1px solid var(--line);}
.accordion-q{padding:18px 0; display:flex; justify-content:space-between; align-items:center; cursor:pointer; font-family:'Oswald',sans-serif; font-size:16px;}
.accordion-a{display:none; padding-bottom:18px; color:var(--bone-dim); font-size:14px; max-width:640px;}
.accordion-item.open .accordion-a{display:block;}
.accordion-item.open .chev{transform:rotate(45deg);}
.chev{transition:transform .15s; color:var(--blood); font-size:20px;}

/* cart drawer */
.overlay{position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:200; display:none;}
.overlay.open{display:block;}
.drawer{
  position:fixed; top:0; right:0; height:100%; width:380px; max-width:92vw;
  background:var(--panel); border-left:1px solid var(--line); z-index:201;
  transform:translateX(100%); transition:transform .25s ease; display:flex; flex-direction:column;
}
.drawer.open{transform:translateX(0);}
.drawer-head{padding:20px; border-bottom:1px solid var(--line); display:flex; justify-content:space-between; align-items:center;}
.drawer-body{flex:1; overflow-y:auto; padding:16px 20px;}
.drawer-foot{padding:20px; border-top:1px solid var(--line);}
.cart-line{display:flex; gap:12px; padding:12px 0; border-bottom:1px solid var(--line); align-items:center;}
.cart-line .thumb{width:52px; height:52px; background:var(--void-2); flex-shrink:0;}
.cart-line .info{flex:1;}
.cart-line .name{font-size:14px;}
.cart-line .meta{font-size:12px; color:var(--bone-dim);}
.qty-ctrl{display:flex; align-items:center; gap:8px;}
.qty-ctrl button{width:22px; height:22px; background:var(--void-2); border:1px solid var(--line); color:var(--bone); cursor:pointer;}

/* dashboard */
.dash-grid{display:grid; grid-template-columns:220px 1fr; gap:32px;}
@media(max-width:800px){.dash-grid{grid-template-columns:1fr;}}
.dash-nav button{
  display:block; width:100%; text-align:left; background:none; border:none; color:var(--bone-dim);
  padding:12px 14px; font-family:'JetBrains Mono',monospace; font-size:12px; text-transform:uppercase;
  letter-spacing:0.05em; cursor:pointer; border-left:2px solid transparent;
}
.dash-nav button.active{color:var(--bone); border-left-color:var(--blood); background:var(--void-2);}
.stat-row{display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-bottom:28px;}
@media(max-width:600px){.stat-row{grid-template-columns:1fr;}}
.stat{background:var(--void-2); border:1px solid var(--line); padding:16px;}
.stat .n{font-family:'JetBrains Mono',monospace; font-size:26px; color:var(--blood);}
.stat .l{font-size:11px; color:var(--bone-dim); text-transform:uppercase; letter-spacing:0.06em; margin-top:4px;}
table.data{width:100%; border-collapse:collapse; font-size:13px; min-width:480px;}
table.data th{text-align:left; font-family:'JetBrains Mono',monospace; font-size:11px; text-transform:uppercase; color:var(--bone-dim); padding:8px 10px; border-bottom:1px solid var(--line);}
table.data td{padding:10px; border-bottom:1px solid var(--line);}
.status-chip{font-family:'JetBrains Mono',monospace; font-size:10px; padding:3px 8px; text-transform:uppercase;}
.status-chip.ok{color:#7fd88f; border:1px solid #7fd88f;}
.status-chip.pending{color:var(--toxic); border:1px solid var(--toxic);}

.empty-state{padding:40px 20px; text-align:center; color:var(--bone-dim); border:1px dashed var(--line);}
.empty-state .btn{margin-top:16px;}

@media(max-width:820px){
  nav.links{display:none;}
  .burger{display:flex; background:none; border:1px solid var(--line); color:var(--bone); width:36px; height:36px; align-items:center; justify-content:center; cursor:pointer;}
  nav.links.mobile-open{
    display:flex; flex-direction:column; position:fixed; top:85px; left:0; right:0; background:var(--void);
    border-bottom:1px solid var(--line); padding:8px 0; z-index:99;
  }
  nav.links.mobile-open button{text-align:left; padding:14px 24px; border-bottom:1px solid var(--line);}
}
@media(max-width:600px){
  .navbar{padding:7px 16px;}
  .nav-logo-img{height:52px; max-width:150px;}
  .footer-logo-img{height:98px; max-width:86vw;}
  nav.links.mobile-open{top:67px;}
}
@media(min-width:1024px){
  .nav-logo-img{height:92px; max-width:250px;}
}
</style>
</head>
<body>

<header>
  <div class="navbar">
    <div class="brand-block" style="display:flex; flex-direction:column; gap:10px; align-items:flex-start;">
    <div class="brand" onclick="go('home')"><img src="assets/logos/slaughter-to-prevail-header.png" alt="Slaughter to Prevail" class="nav-logo-img"></div>
      <div style="display:flex; gap:8px;"></div>
    </div>
    <nav class="links" id="navLinks">
      <button data-view="home" class="active">Home</button>
      <button data-view="store">Store</button>
      <button data-view="membership">Membership</button>
      <button data-view="tours">Tours</button>
      <button data-view="tickets">Tickets</button>
      <button data-view="gallery">Gallery</button>
      <button data-view="news">News</button>
      <button data-view="ngo">NGO</button>
      <button data-view="support">Support</button>
    </nav>
    <div class="nav-actions">
      <button class="icon-btn burger" onclick="toggleMobileNav()">☰</button>
      <button class="icon-btn" onclick="openCart()" aria-label="Cart">
        🛒<span class="badge-count" id="cartCount" style="display:none;">0</span>
      </button>
    </div>
  </div>
</header>

<!-- ============ HOME ============ -->
<div class="view active" id="view-home">
  <section class="hero">
    <div class="hero-inner">
      <h1>KENTUCKY<br><span>VAMPIRE</span> TOUR</h1>
      <div class="hero-actions">
        <button class="btn" onclick="go('tickets')">Reserve tickets</button>
        <button class="btn ghost" onclick="go('store')">Shop merch</button>
      </div>
      <div class="countdown-label">NEXT SHOW · <span id="nextShowLabel"></span></div>
      <div class="countdown-block" id="countdown">
        <div class="seg"><div class="num" id="cd-d">--</div><div class="lbl">Days</div></div>
        <div class="seg"><div class="num" id="cd-h">--</div><div class="lbl">Hrs</div></div>
        <div class="seg"><div class="num" id="cd-m">--</div><div class="lbl">Min</div></div>
        <div class="seg"><div class="num" id="cd-s">--</div><div class="lbl">Sec</div></div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <h2>Latest announcements</h2>
        <button class="btn ghost small" onclick="go('news')">All news →</button>
      </div>
      <div class="grid cols-3" id="homeNewsGrid"></div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <div class="section-head">
        <h2>Featured Activities</h2>
      </div>
      <div class="grid cols-3">
        <div class="card"><div class="media-block wide"><img src="data:image/jpeg;base64," alt="Festival main stage crowd" style="width:100%;height:100%;object-fit:cover;position:relative;z-index:1;"></div><div class="product-name">Festival Main Stage</div><div class="product-cat">Live performance</div></div>
        <div class="card"><div class="media-block wide"><img src="data:image/jpeg;base64," alt="Slaughter to Prevail live on stage" style="width:100%;height:100%;object-fit:cover;position:relative;z-index:1;"></div><div class="product-name">Full Band Live</div><div class="product-cat">Concert footage</div></div>
        <div class="card"><div class="media-block wide"><img src="data:image/jpeg;base64," alt="Alex Terrible performing live" style="width:100%;height:100%;object-fit:cover;position:relative;z-index:1;"></div><div class="product-name">On the Mic</div><div class="product-cat">Live performance</div></div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head"><h2>Upcoming shows</h2><button class="btn ghost small" onclick="go('tours')">Full schedule →</button></div>
      <div id="homeToursList"></div>
    </div>
  </section>
</div>

<!-- ============ STORE ============ -->
<div class="view" id="view-store">
  <section style="padding-top:40px;">
    <div class="wrap">
      <div class="eyebrow">Official merchandise</div>
      <h2 style="font-size:clamp(30px,5vw,46px); margin:12px 0 8px;">The store</h2>
      <p style="color:var(--bone-dim); max-width:560px; margin-bottom:20px;">Masks, tees, hoodies and limited drops. Members save automatically at checkout.</p>
      <div style="display:flex; gap:10px; margin-bottom:28px; flex-wrap:wrap;">
        <button class="btn small" id="filter-all" onclick="setStoreFilter('all')">All items</button>
        <button class="btn small ghost" id="filter-order" onclick="setStoreFilter('order')">In stock — order now</button>
        <button class="btn small ghost" id="filter-preorder" onclick="setStoreFilter('preorder')">Pre-order</button>
      </div>
      <div id="storeSections"></div>
    </div>
  </section>
</div>

<!-- ============ MEMBERSHIP ============ -->
<div class="view" id="view-membership">
  <section style="padding-top:40px;">
